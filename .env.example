# --- App ---
# Public base URL of your deployed app, no trailing slash
APP_BASE_URL=https://your-app.vercel.app

# From aistudio.google.com — free tier, used server-side only, never exposed to the browser
GEMINI_API_KEY=

# 32-byte hex key used to encrypt stored access tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Supabase (token storage + photo storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Create a public Storage bucket named "ibase-photos" in the Supabase dashboard before deploying —
# uploaded photos need to be publicly reachable so Meta/LinkedIn's APIs can fetch them.

# --- Meta (Facebook Page + Instagram Business) ---
# From developers.facebook.com > Your App > Settings > Basic
META_APP_ID=
META_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" in your Meta App's Facebook Login settings
META_REDIRECT_URI=${APP_BASE_URL}/api/auth/meta/callback

# --- LinkedIn ---
# From developer.linkedin.com > Your App > Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=${APP_BASE_URL}/api/auth/linkedin/callback
# The organization URN you're posting as, e.g. urn:li:organization:12345678
# You only get this after LinkedIn approves Community Management API access — see README.
LINKEDIN_ORG_URN=

# Secret for /api/cron/publish-scheduled (any long random string). Scheduler must send it as a Bearer token.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# AUTH_SECRET (long random string) signs login sessions.
# Who may create an account: set GOOGLE_ALLOWED_EMAILS (below) — it's used for email signup too.
AUTH_SECRET=

# --- Google login ("Continue with Google") ---
# From console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_REDIRECT_URI=${APP_BASE_URL}/api/auth/google/callback
# Who may sign in with Google if they don't already have an account here.
# Comma-separated exact emails and/or @domain entries, e.g. you@gmail.com,@ibaseelectrosoft.com
GOOGLE_ALLOWED_EMAILS=
